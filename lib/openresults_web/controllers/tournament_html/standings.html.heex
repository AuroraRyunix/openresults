<.masthead payload={@payload} slug={@slug} current={@current} />

<section>
  <h2>
    Standings
    <span :if={Tournament.standings(@payload)["after_round"]} class="quiet">
      after round {Tournament.standings(@payload)["after_round"]}
    </span>
  </h2>

  <.standings_table payload={@payload} slug={@slug} />

  <%!-- Keizer's ladder is not a FIDE tiebreak table and reads like a broken
        one if nobody says so: the points move for reasons that are not in the
        results column. --%>
  <p :if={Tournament.keizer?(@payload)} class="footnote">
    These are Keizer points, not FIDE tiebreaks - the whole ladder is
    recalculated from results, byes and absences every time.
  </p>
</section>
