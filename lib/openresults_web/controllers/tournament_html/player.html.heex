<.masthead payload={@payload} slug={@slug} current={@current} />

<section>
  <h2>
    <span :if={Tournament.show?(@payload, "title") && @player["title"]} class="title">
      {@player["title"]}
    </span>
    {@player["name"]}
    <span class="quiet">no. {@player["no"]}</span>
  </h2>

  <p class="details">
    <span :if={Tournament.show?(@payload, "rating") && @player["rating"]}>{@player["rating"]}</span>
    <span :if={Tournament.show?(@payload, "federation") && @player["federation"]}>
      {@player["federation"]}
    </span>
    <span :if={Tournament.show?(@payload, "club") && @player["club"]}>{@player["club"]}</span>
    <span :if={Tournament.show?(@payload, "category") && @player["category"]}>
      Category {@player["category"]}
    </span>
  </p>

  <.card_table slug={@slug} card={@card} payload={@payload} />

  <p :if={Enum.any?(@card, &is_nil(&1.score))} class="footnote">
    The running score stops at the first round whose result is not public - an
    unpublished round, a board that is not listed, or a game with no result yet.
    The arbiter's own total is on the <a href={~p"/t/#{@slug}"}>standings</a>.
  </p>
</section>
