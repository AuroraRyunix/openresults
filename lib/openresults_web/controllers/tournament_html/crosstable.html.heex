<.masthead
  payload={@payload}
  slug={@slug}
  current={@current}
  query={OpenResultsWeb.FilterParams.to_params(@filters)}
/>

<section>
  <%!-- No "after round N" beside this heading, unlike the standings. The
        grid IS capped at `standings.after_round` now - see
        `Tournament.within_standings?/2` - but a round the arbiter withheld
        inside that range still leaves a gap, so the highest column does not
        always equal that number either. The round headings say which
        rounds are actually here. --%>
  <h2>{gettext("Cross-table")}</h2>

  <.crosstable_table payload={@payload} slug={@slug} filters={@filters} />

  <.withheld_results_note rounds={Tournament.withheld_result_rounds(@payload)} payload={@payload} />
</section>
