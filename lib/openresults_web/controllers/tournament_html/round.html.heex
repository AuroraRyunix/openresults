<%= if @display? do %>
  <.projector_round payload={@payload} slug={@slug} round={@round} players={@players} />
<% else %>
  <.masthead
    payload={@payload}
    slug={@slug}
    current={@current}
    query={OpenResultsWeb.FilterParams.to_params(@filters)}
  />

  <section>
    <%!-- The "dates" tick covers a round's own date as well as the
          tournament's - that is what it says on the arbiter's settings page,
          and it is the only reading that makes sense: a tournament whose dates
          are hidden but whose five round pages each print one is not hiding
          anything. The masthead above already honours it; this heading did
          not. --%>
    <h2>
      {Tournament.round_heading(@payload, @round["number"])}
      <span :if={Tournament.show?(@payload, "dates") && @round["date"]} class="quiet">
        {date(@round["date"])}
      </span>
      <.live_marker round={@round} />
    </h2>

    <.withheld_results_note
      rounds={if Tournament.results_public?(@round), do: [], else: [@round["number"]]}
      payload={@payload}
    />

    <.matches_table
      :if={Tournament.team_event?(@payload)}
      payload={@payload}
      slug={@slug}
      round={@round}
      players={@players}
    />

    <.pairings_table
      slug={@slug}
      round={@round}
      players={@players}
      payload={@payload}
      filters={@filters}
    />

    <%!-- The projector view was reachable only by knowing to add ?display=1,
          which is no way to find a feature. A plain link: whoever is setting
          up the screen in the hall is on this page already. --%>
    <%!-- Two screens for the hall. The projector view is this round and
          nothing else, a plain document that keeps going with no
          connection; the hall display follows the tournament - the newest
          round, the names, the results as they arrive, the standings, the
          arbiter's announcement - and needs one. --%>
    <p class="quiet">
      <a href={~p"/t/#{@slug}/round/#{@round["number"]}?display=1"}>
        {gettext("Projector view - large boards, cycling automatically")}
      </a>
      <span aria-hidden="true">·</span>
      <a id="hall-display-link" href={~p"/t/#{@slug}/hall"}>
        {gettext(
          "Hall display - pairings, results and standings in turn, always the newest round"
        )}
      </a>
    </p>
  </section>

  <section :if={Tournament.show?(@payload, "byes") and Tournament.byes(@round) != []}>
    <h2>{gettext("Byes")}</h2>

    <.byes_table slug={@slug} round={@round} players={@players} payload={@payload} />
  </section>
<% end %>
