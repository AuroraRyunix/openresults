<header class="masthead">
  <h1>{gettext("Too many entries")}</h1>
</header>

<section>
  <p class="empty">
    {gettext(
      "Several entries have already arrived from this connection, so this one was not sent and nothing has been stored."
    )}
    {ngettext(
      "Try again in about %{count} minute.",
      "Try again in about %{count} minutes.",
      @minutes
    )}
  </p>

  <p class="footnote">
    {gettext(
      "A shared connection counts as one: a club, a school or a venue's wifi all look the same from here. If a group is entering together, leave a few minutes between entries, or send the list to the organisers instead."
    )}
  </p>

  <p><a href={@back}>{gettext("Back")}</a></p>
</section>
