<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
      {[assigns[:page_title], "OpenResults"] |> Enum.reject(&is_nil/1) |> Enum.join(" - ")}
    </title>
    <link rel="icon" href={~p"/favicon.svg"} type="image/svg+xml" />
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
    <%!--
      There was no script tag here at all, and the reason was good: these
      pages are read-only, carry no session, and hundreds of phones load them
      over a playing hall's wifi, so a result should be readable the moment
      the HTML lands.

      That promise is intact. What follows is not an application - there is
      no bundle, no socket, no framework and no request on load. It is a
      preference reader that runs before first paint (inline, so there is no
      round trip and no flash of the wrong theme) and, further down, a
      right-click handler and a refresher, both of which only ever act after
      the page is already readable.

      Every page still renders completely with all of it switched off: the
      theme falls back to the device's own light/dark setting, and a player's
      name is still a link to their card. Nothing here is load-bearing, which
      is the condition under which adding it was worth it.
    --%>
    <script>
      (() => {
        const KEY = "openresults:theme";
        const root = document.documentElement;

        // localStorage THROWS rather than returning null where a browser
        // blocks site data - a private window, or a partitioned third-party
        // frame, which is exactly the club-embed case this site supports.
        // Unguarded, that would take the whole bootstrap down.
        const read = () => { try { return localStorage.getItem(KEY); } catch (_) { return null; } };

        const saved = read();

        // No choice made yet means LIGHT, not "follow the device".
        //
        // Following the device is the better default for an application
        // somebody lives in. This is a page a spectator opens once, often
        // embedded in a club's own site - and a club site is overwhelmingly
        // light, so a dark slab dropped into the middle of one reads as
        // broken rather than as a theme. The same argument applies to a
        // projector in a hall, which is the other place these pages end up.
        //
        // "Match device" is still there, one click away, and once chosen it
        // wins and persists. Only the default changed.
        if (saved) {
          if (saved === "system") {
            // Deliberately no attribute: the stylesheet's
            // prefers-color-scheme query is what decides, and writing
            // "system" into the attribute would stop it matching.
            root.setAttribute("data-theme-source", "system");
          } else {
            root.setAttribute("data-theme", saved);
            root.setAttribute("data-theme-source", "user");
          }
        } else {
          root.setAttribute("data-theme", "paper");
          root.setAttribute("data-theme-source", "default");
        }

        root.classList.add("has-js");
      })();
    </script>
  </head>
  <body>
    <div class="page">
      <%!-- The picker lives up here, not in the footer where it started.
            A popover anchored to the last element on the page can only open
            upwards, and an absolutely positioned panel does not grow the
            document - so at the bottom of a long page part of it was simply
            outside the viewport with no way to scroll to it. Up here it opens
            downwards into a page that already has room, which is also where
            the arbiter's app keeps its own. --%>
      <div class="masthead-bar">
        <a class="brand" href={~p"/"}>
          <.logo /> OpenResults
        </a>
        <%!-- The same popover the arbiter's app uses, so the two feel like
              one system. The active option is highlighted purely from CSS,
              keyed off the `data-theme` / `data-theme-source` attributes the
              inline script maintains on <html> - no server state, and it
              reflects the choice instantly. --%>
        <details class="theme-picker">
          <summary class="theme-picker-trigger" title="Colour theme" aria-label="Colour theme">
            <span class="theme-picker-swatch" aria-hidden="true"></span> Theme
          </summary>
          <div class="theme-picker-panel" role="group" aria-label="Colour theme">
            <button
              :for={
                {key, label} <- [
                  {"system", "Match device"},
                  {"paper", "Paper"},
                  {"night", "Night"},
                  {"board", "Board"},
                  {"slate", "Slate"},
                  {"contrast", "High contrast"}
                ]
              }
              type="button"
              class="theme-picker-item"
              data-theme-opt={key}
            >
              <span class={"theme-dot theme-dot-#{key}"} aria-hidden="true"></span>
              {label}
            </button>
          </div>
        </details>
      </div>
      <%!-- `data-live` marks the region the refresher replaces. Everything
            outside it - the theme, the scroll position, an open card - is
            untouched, which is the whole reason this is not a page reload. --%>
      <div id="live-region" data-live>{@inner_content}</div>

      <footer class="site-foot">
        <span>Published by the arbiter. Results are theirs, not this site's.</span>
        <span id="live-status" class="live-status" hidden aria-live="polite"></span>
        <span class="spacer"></span>
        <%!-- In the footer of a site with no login, because the person asking
              "did my deploy land" is looking at this from outside. A version
              number could not answer it: this app reported the same 0.1.0 for
              weeks while never having been deployed at all. --%>
        <span class="build-id" title={OpenResults.Build.long()}>
          {OpenResults.Build.id()}
        </span>
      </footer>
    </div>

    <%!--
      The player card, shown in place on right-click.

      Empty until something asks for it, and filled from the player's own
      page rather than from data embedded here - a 200-player open would
      otherwise ship every card to every visitor to serve the handful who
      open one. Left-click still navigates to that page, which is what
      happens with no JavaScript, on a phone, and whenever the fetch fails.
    --%>
    <div id="card-overlay" class="card-overlay" hidden>
      <div class="card-dialog" role="dialog" aria-modal="true" aria-label="Player card">
        <button type="button" class="card-close" aria-label="Close">Close</button>
        <div id="card-body">
          <p class="card-loading">Loading…</p>
        </div>
      </div>
    </div>

    <script>
      (() => {
        const KEY = "openresults:theme";
        const root = document.documentElement;

        const write = (v) => { try { localStorage.setItem(KEY, v); } catch (_) {} };
        const read = () => { try { return localStorage.getItem(KEY); } catch (_) { return null; } };

        // ---- theme switch ----
        const picker = document.querySelector(".theme-picker");

        if (picker) {
          picker.addEventListener("click", (e) => {
            const button = e.target.closest("[data-theme-opt]");
            if (!button) { return; }

            const value = button.dataset.themeOpt;
            write(value);

            if (value === "system") {
              root.removeAttribute("data-theme");
              root.setAttribute("data-theme-source", "system");
            } else {
              root.setAttribute("data-theme", value);
              root.setAttribute("data-theme-source", "user");
            }

            // A popover that stays open after you have chosen is a popover
            // you have to dismiss twice.
            picker.removeAttribute("open");
          });
        }

        // ---- the player card ----
        const overlay = document.getElementById("card-overlay");
        const body = document.getElementById("card-body");
        if (!overlay || !body) { return; }

        const close = () => {
          overlay.hidden = true;
          body.innerHTML = '<p class="card-loading">Loading…</p>';
        };

        overlay.addEventListener("click", (e) => { if (e.target === overlay) { close(); } });
        overlay.querySelector(".card-close").addEventListener("click", close);
        document.addEventListener("keydown", (e) => { if (e.key === "Escape") { close(); } });

        // ---- keeping the page current ----
        //
        // The pages this replaced were LiveViews on a PubSub topic: standings
        // moved as results were entered. This site is static by design, and a
        // spectator refreshing their phone every two minutes was the most
        // visible thing lost in the move.
        //
        // A re-fetch and a swap, not a reload. `location.reload()` would be
        // four lines and would throw away scroll position every 20 seconds,
        // which on a 200-player standings table means losing your place while
        // reading it - worse than the problem.
        //
        // Deliberately does nothing at all on the entry form: replacing the
        // DOM under somebody who is typing would clear what they had written.
        const live = document.getElementById("live-region");
        const status = document.getElementById("live-status");
        const isForm = !!document.querySelector("#registration-form");

        if (live && !isForm) {
          let failures = 0;

          const swap = (html) => {
            const doc = new DOMParser().parseFromString(html, "text/html");
            const fresh = doc.getElementById("live-region");
            if (!fresh) { throw new Error("no live region"); }

            // Compare before touching the DOM. Most polls find nothing new,
            // and replacing identical markup would collapse an open <details>
            // and drop focus for no reason.
            if (fresh.innerHTML === live.innerHTML) { return false; }

            live.innerHTML = fresh.innerHTML;
            return true;
          };

          const tick = () => {
            // Nothing to update while the tab is in the background, and a
            // phone in a pocket should not be polling a server all round.
            if (document.hidden) { return; }

            fetch(window.location.href, {headers: {"accept": "text/html"}})
              .then((r) => r.ok ? r.text() : Promise.reject(r.status))
              .then((html) => {
                failures = 0;
                if (status) { status.hidden = true; }
                if (swap(html)) {
                  // Said quietly and only when something actually changed, so
                  // a spectator knows the page is live rather than stuck.
                  if (status) {
                    status.textContent = "updated just now";
                    status.hidden = false;
                  }
                }
              })
              .catch(() => {
                // A hall's wifi drops. Say so rather than showing a page that
                // has silently stopped being current, and keep trying - this
                // is not an error worth ending the session over.
                failures += 1;
                if (failures >= 2 && status) {
                  status.textContent = "not updating - connection lost";
                  status.hidden = false;
                }
              });
          };

          setInterval(tick, 20000);
          // A tab brought back to the front is stale by however long it was
          // hidden, and its reader is looking at it right now.
          document.addEventListener("visibilitychange", () => {
            if (!document.hidden) { tick(); }
          });
        }

        // ---- finding yourself on the FIDE list ----
        //
        // Fills the form's fields; never required, never blocking. Everything
        // it would fill can be typed, and a player who is not on the FIDE list
        // ignores it entirely. The panel is only rendered where this
        // deployment can actually reach an arbiter's list, so there is no
        // "search unavailable" state to explain.
        const fide = document.getElementById("fide-search");

        if (fide) {
          const box = document.getElementById("fide-query");
          const list = document.getElementById("fide-results");
          const none = document.getElementById("fide-none");
          const endpoint = fide.dataset.endpoint;
          let timer = null;
          let latest = 0;

          const field = (name) => document.getElementById("registration_" + name);

          const fill = (player) => {
            // Only what came back. A blank from the FIDE list means "not
            // recorded", and writing it over something the person already
            // typed would be this page deciding it knows better.
            const set = (name, value) => {
              const el = field(name);
              if (el && value !== null && value !== undefined && value !== "") {
                el.value = value;
              }
            };

            set("name", player.name);
            set("rating", player.rating);
            set("federation", player.federation);
            set("fide_id", player.fide_id);
            set("title", player.title);
            set("birth_year", player.birth_year);

            list.hidden = true;
            none.hidden = true;
            box.value = "";
            // Straight to the one field the list cannot supply, which is the
            // one the arbiter actually needs.
            field("email")?.focus();
          };

          const render = (players) => {
            list.replaceChildren();

            if (!players.length) {
              list.hidden = true;
              none.hidden = false;
              return;
            }

            none.hidden = true;

            for (const player of players) {
              const li = document.createElement("li");
              const button = document.createElement("button");
              button.type = "button";

              const who = document.createElement("span");
              who.className = "who";
              who.textContent = [player.title, player.name].filter(Boolean).join(" ");

              const about = document.createElement("span");
              about.className = "about";
              about.textContent = [player.federation, player.rating, player.birth_year]
                .filter(Boolean)
                .join(" \u00b7 ");

              button.append(who, about);
              button.addEventListener("click", () => fill(player));
              li.append(button);
              list.append(li);
            }

            list.hidden = false;
          };

          const run = (query) => {
            // Every response carries the number of the request that asked for
            // it. Without that, a slow search for "van" can land after a fast
            // one for "van der berg" and replace the right answers with
            // stale ones.
            const mine = ++latest;

            fetch(endpoint + "?q=" + encodeURIComponent(query), {
              headers: {"accept": "application/json"},
            })
              .then((r) => r.ok ? r.json() : Promise.reject(r.status))
              .then((data) => {
                if (mine !== latest) { return; }
                render(data.players || []);
              })
              .catch(() => {
                // The form works without this. An error about somebody else's
                // server is not something the person typing their name can do
                // anything with.
                if (mine !== latest) { return; }
                list.hidden = true;
                none.hidden = false;
              });
          };

          box.addEventListener("input", () => {
            clearTimeout(timer);
            const query = box.value.trim();

            if (query.length < 2) {
              list.hidden = true;
              none.hidden = true;
              return;
            }

            // A request per keystroke would be a search per letter of a
            // surname, against a machine that is also running a tournament.
            timer = setTimeout(() => run(query), 250);
          });

          // The panel is inside the form, so Enter in it would submit a
          // half-filled entry.
          box.addEventListener("keydown", (e) => {
            if (e.key === "Enter") { e.preventDefault(); }
          });

          document.addEventListener("click", (e) => {
            if (!fide.contains(e.target)) { list.hidden = true; }
          });
        }

        document.addEventListener("contextmenu", (e) => {
          const link = e.target.closest("a.player[data-player]");
          if (!link) { return; }
          e.preventDefault();

          overlay.hidden = false;

          fetch(link.href, {headers: {"accept": "text/html"}})
            .then((r) => r.ok ? r.text() : Promise.reject(r.status))
            .then((html) => {
              const doc = new DOMParser().parseFromString(html, "text/html");
              // The SUMMARY section, not the page's first one. The page
              // carries a second, much longer section - the chart, the
              // round-by-round table, every tie-break contribution - and
              // lifting that into a dialog would make the peek and the page
              // the same thing again, which is what this stopped being.
              const section = doc.querySelector("#player-summary");
              if (!section) { throw new Error("no card"); }
              body.replaceChildren(section);
            })
            .catch(() => {
              // The card is a convenience; the page behind it is the real
              // thing. Falling through to it beats an error message about a
              // feature the visitor did not know existed.
              close();
              window.location.href = link.href;
            });
        });
      })();
    </script>
  </body>
</html>
